<Window x:Class="OMSApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Order Manager" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#4A9B9B" Padding="10,8">
            <TextBlock Text="Manage Orders"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Navigation Buttons -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Background="#5AABAB"
                    Margin="0">
            <Button Content="List Order Details"
                    Command="{Binding ShowListOrderDetailsCommand}"
                    Padding="12,6"
                    Margin="4,4,0,4"
                    Background="#3A8A8A"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Add Item to Order"
                    Command="{Binding ShowAddNewItemCommand}"
                    Padding="12,6"
                    Margin="4,4,0,4"
                    Background="#3A8A8A"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Exit"
                    Command="{Binding ExitCommand}"
                    Padding="12,6"
                    Margin="4,4,0,4"
                    Background="#3A8A8A"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>

        <!-- Content Area -->
        <ContentControl Content="{Binding CurrentView}" Margin="0"/>
    </DockPanel>
</Window>
