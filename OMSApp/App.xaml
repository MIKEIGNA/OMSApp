<Application x:Class="OMSApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OMSApp"
             xmlns:views="clr-namespace:OMSApp.Views"
             xmlns:vm="clr-namespace:"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:ListOrderDetailsViewModel}">
            <views:ListOrderDetailsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddNewItemViewModel}">
            <views:AddNewItemView/>
        </DataTemplate>
    </Application.Resources>
</Application>
