<UserControl x:Class="OMSApp.Views.ListOrderDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Margin="10">
        <!-- Basket ComboBox -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
            <TextBlock Text="Basket:" VerticalAlignment="Center" Width="60"/>
            <ComboBox ItemsSource="{Binding Baskets}"
                      SelectedItem="{Binding SelectedBasket}"
                      DisplayMemberPath="DisplayText"
                      Width="300"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding BasketItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Height="300"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Basket ID"
                                    Binding="{Binding IdBasket}" Width="80"/>
                <DataGridTextColumn Header="BasketItem ID"
                                    Binding="{Binding IdBasketItem}" Width="100"/>
                <DataGridTextColumn Header="Product ID"
                                    Binding="{Binding IdProduct}" Width="80"/>
                <DataGridTextColumn Header="Product Name"
                                    Binding="{Binding Product.ProductName}" Width="120"/>
                <DataGridTextColumn Header="Unit Price"
                                    Binding="{Binding Product.Price}" Width="80"/>
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
